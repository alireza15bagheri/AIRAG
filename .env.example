# AIRAG Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Application Settings
# ==========================================
APP_NAME=AIRAG
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==========================================
# Server Settings
# ==========================================
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ==========================================
# Document Processing
# ==========================================
# Supported: pdf, docx, md, txt
ALLOWED_EXTENSIONS=pdf,docx,md,txt
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# ==========================================
# Chunking Configuration
# ==========================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_STRATEGY=sentence_aware  # fixed, sentence_aware, semantic

# ==========================================
# Embeddings
# ==========================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # cpu, cuda, mps
EMBEDDING_BATCH_SIZE=32

# ==========================================
# Vector Database (ChromaDB)
# ==========================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents
CHROMA_DISTANCE_FUNCTION=cosine  # cosine, l2, ip

# ==========================================
# Retrieval
# ==========================================
TOP_K=5
SIMILARITY_THRESHOLD=0.7
ENABLE_METADATA_FILTERING=false

# ==========================================
# LLM (Ollama)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9

# ==========================================
# Generation
# ==========================================
MAX_CONTEXT_TOKENS=4000
SYSTEM_PROMPT=You are a helpful assistant that answers questions based only on the provided context. If the context doesn't contain enough information, say so.
ENABLE_STREAMING=true

# ==========================================
# API Security (Future)
# ==========================================
# API_KEY=
# SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# External APIs (Future - Optional)
# ==========================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=